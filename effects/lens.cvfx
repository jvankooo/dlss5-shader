//! name: Lens
//! description: Colour fringing, vignette, barrel distortion and edge blur.

uniform float LensFringe   : default=0.3, min=0.0,  max=1.0, label="Colour fringing";
uniform float LensVignette : default=0.25, min=0.0, max=1.0, label="Vignette";
uniform float LensRound    : default=0.5, min=0.0,  max=1.0, label="Vignette roundness";
uniform float LensBarrel   : default=0.0, min=-1.0, max=1.0, label="Distortion";
uniform float LensBlur     : default=0.0, min=0.0,  max=1.0, label="Edge blur";

float4 effect(float2 uv) {
    float aspect = resolution.x / resolution.y;
    float2 d = uv - 0.5;
    float2 round_ = float2(d.x * aspect, d.y);
    // 1 at the corners whatever the shape of the picture.
    float r2 = dot(round_, round_) / (0.25 * (aspect * aspect + 1.0));

    // Barrel is scaled so the corners stay put and no border shows; pincushion
    // pulls inward from the corners for the same reason.
    float k = LensBarrel * 0.25;
    float2 bent = d * (1.0 + k * r2) / (1.0 + max(k, 0.0));

    // Red and blue focus at different sizes, so they spread along the radius.
    // Seven steps of it rather than two ghost copies.
    float3 sum = float3(0.0, 0.0, 0.0);
    float3 wsum = float3(0.0, 0.0, 0.0);
    for (int i = 0; i < 7; ++i) {
        float t = float(i) / 3.0 - 1.0;
        float2 at = bent * (1.0 + t * r2 * (LensFringe * 0.012 + LensBlur * 0.02));
        float3 spectrum = float3(saturate(t * 1.5), 1.0 - abs(t) * 0.999, saturate(-t * 1.5));
        // Blur alone spreads every channel alike.
        float mixAmount = LensFringe / max(LensFringe + LensBlur, 0.001);
        float3 w = lerp(float3(1.0, 1.0, 1.0), spectrum, mixAmount);
        sum += sample_input(0.5 + at).rgb * w;
        wsum += w;
    }
    float3 c = sum / max(wsum, 0.001);
    c = lerp(sample_input(0.5 + bent).rgb, c, saturate((LensFringe + LensBlur) * 100.0));

    float boxed = dot(d, d) * 2.0;
    float v = lerp(boxed, r2, LensRound);
    c *= 1.0 - LensVignette * smoothstep(0.15, 1.1, v) * 0.9;
    return float4(saturate(c), 1.0);
}
